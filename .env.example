# Build-time public values (copy to `.env.local`, which is ignored).
# Both are optional: without them the site builds with analytics off and the
# quote form shown disabled with the direct contact channels.

# Google Analytics 4 measurement ID (format G-XXXXXXXXXX). Off by default.
# NEXT_PUBLIC_GA_TRACKING_ID=

# Cloudflare Turnstile site key for the quote form. For local testing use the
# public TEST key that always passes: 1x00000000000000000000AA
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
